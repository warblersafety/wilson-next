  "sources": [
    {
      "id": "source-f474da8b-5d77-4340-b82d-101128c16aec",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "Entirely fictional case LIVE-MULTI-57: a 57-year-old man weighing 70 kg developed a rash on 03 September 2026. ",
      "start": 31,
      "end": 142,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-c12c427f-289e-4dec-b32a-42239f0ee508",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "He was hospitalized; no other serious outcomes apply. ",
      "start": 510,
      "end": 564,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-3ab4fe23-e182-4bda-8db0-7253e1ad5a28",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "No additional relevant history applies. ",
      "start": 742,
      "end": 782,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-398579c8-6ae2-4929-b6db-c2e34b9bc1a2",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "This is an adverse-event report, and the product is not available for evaluation. ",
      "start": 782,
      "end": 864,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-2e263655-e4f7-4b83-a483-43e719fafe6e",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "He took warfarin 5 mg by mouth daily from 01 August 2026 for atrial fibrillation and acetaminophen 650 mg by mouth every six hours from 01 September 2026 for pain. ",
      "start": 142,
      "end": 306,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-b6793929-714a-430c-9eb9-420a065a8d71",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "These two products are explicitly medications.",
      "start": 864,
      "end": 910,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-fb70c717-c925-4b98-a96e-c68e16a7d14e",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "Warfarin is suspect; acetaminophen is concomitant. ",
      "start": 306,
      "end": 357,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-30f319d5-7b69-44cc-a9d5-7f29583f715a",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "Warfarin was stopped on 04 September 2026, the rash improved after stopping, and warfarin was never restarted. ",
      "start": 357,
      "end": 468,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-cfe2ea4e-5d71-4144-8feb-2fc6e25c446b",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "Acetaminophen was not stopped or reduced. ",
      "start": 468,
      "end": 510,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-448fb16f-59ec-4ef4-9226-b69e00f65e33",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "INR was 4.8 on 03 September 2026 with reference limits 0.8 and 1.2; ALT was 67 U/L on 03 September 2026 with reference limits 7 and 56. ",
      "start": 564,
      "end": 700,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:47:43.233Z"
    },
    {
      "id": "source-e656fc89-fd96-4d04-8064-2416ec55edcb",
      "inputId": "input-e0d45422-f3c6-4b6f-9ebc-153b8ead60c3",
      "inputType": "narrative",
      "excerpt": "The INR collection time was not recorded. ",
