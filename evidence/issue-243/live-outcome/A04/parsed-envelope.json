      "inputType": "narrative",
      "excerpt": "Patient TEST-47 is a 47-year-old man. ",
      "start": 31,
      "end": 69,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:46:01.216Z"
    },
    {
      "id": "source-042e133e-cc3a-4701-9ba2-f273bd9aadda",
      "inputId": "input-0635f5c4-5547-47f0-b35d-5440080828ad",
      "inputType": "narrative",
      "excerpt": "He began warfarin 5 mg by mouth daily on 01-Aug-2026 for atrial fibrillation and acetaminophen 650 mg by mouth every six hours on 02-Aug-2026. ",
      "start": 69,
      "end": 212,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:46:01.216Z"
    },
    {
      "id": "source-ac20f962-7b22-4b07-a875-fe32044cf559",
      "inputId": "input-0635f5c4-5547-47f0-b35d-5440080828ad",
      "inputType": "narrative",
      "excerpt": "Warfarin is suspect; acetaminophen is concomitant. ",
      "start": 212,
      "end": 263,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:46:01.216Z"
    },
    {
      "id": "source-4f17b622-f7a9-43d2-a0f6-90f34276692f",
      "inputId": "input-0635f5c4-5547-47f0-b35d-5440080828ad",
      "inputType": "narrative",
      "excerpt": "Warfarin was stopped and the symptoms resolved.",
      "start": 420,
      "end": 467,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:46:01.216Z"
    },
    {
      "id": "source-292f3ec0-6fb9-42f7-8da4-cbd91a108938",
      "inputId": "input-0635f5c4-5547-47f0-b35d-5440080828ad",
      "inputType": "narrative",
      "excerpt": "On 08-Aug-2026 he developed epistaxis and easy bruising. ",
      "start": 263,
      "end": 320,
      "actor": "clinician",
      "recordedAt": "2026-10-17T17:46:01.216Z"
    },
    {
